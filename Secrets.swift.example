//
//  Secrets.swift.example
//  Nobody Cares
//
//  SETUP:
//  1. Copy this file to: Nobody Cares/Config/Secrets.swift
//  2. Replace the placeholder values with your Supabase credentials
//  3. The file is gitignored — your keys stay local
//
//  Find your credentials at: https://supabase.com/dashboard
//    → Your Project → Settings → API Keys → Publishable key
//

import Foundation

enum Secrets {
    static let supabaseURL = "https://YOUR_PROJECT_REF.supabase.co"

    // Publishable key (sb_publishable_...) — safe to embed in client apps.
    // Replaces the legacy "anon" key. Find at: Dashboard → Settings → API Keys
    static let supabasePublishableKey = "YOUR_SUPABASE_PUBLISHABLE_KEY"

    // Cloudflare Turnstile — get from https://dash.cloudflare.com → Turnstile
    static let turnstileSiteKey = "YOUR_TURNSTILE_SITE_KEY"
}
